# ============ 打码平台（yescaptcha） ============
# 【必须提供】yescaptcha 的 clientKey：登录 yescaptcha.com 后台复制
# 不填：面板顶栏显示「yescaptcha 未配置」，打码步骤静默跳过（任务可能卡在验证码）
CAPTCHA_CLIENT_KEY=

# ============ 云数据库（Turso，数据层全走云端） ============
# 【必须提供】云数据库连接串与令牌：Turso 控制台创建数据库后 Copy URL / Copy Token
# 不填：服务启动直接报错退出（npm run task:run 脚本同样需要）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ============ 比特浏览器（本机客户端） ============
# 可选：比特浏览器 API 地址，默认 http://127.0.0.1:54345，只有端口/地址改过才需要填
# BITBROWSER_API_BASE=

# ============ 钱包解锁密码（按钱包类型配置） ============
# 可选：JSON 映射「钱包类型 → 解锁密码」。所有窗口同类型的钱包共用同一密码：
#   例：100 个窗口的 MetaMask 密码都一样 → 只写一次 metamask；Petra 密码是另一个 → 另写一条
# 没有配置密码的钱包类型跳过解锁。钱包类型 key 与任务 meta.wallet 一致（目前内置 metamask / petra）
WALLET_PASSWORDS={"metamask":"MetaMask 解锁密码","petra":"Petra 解锁密码"}

# ============ 后端 API 端口 ============
# 可选：后端只出 API（不托管页面），默认 3000；前端 Vite 的 /api 代理自动跟随这个端口
# WEB_PORT=3000

# ============ 前端面板端口（npm run dev 的 Vite 服务，页面 + 热更新） ============
# 可选：面板访问地址就是它，默认 5173，被其它项目占用时改一个
# VITE_PORT=5174
