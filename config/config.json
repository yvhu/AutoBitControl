{
  "bitbrowser": {
    "apiBase": "http://127.0.0.1:54345",
    "openTimeoutMs": 30000,
    "maxRetries": 3,
    "retryBackoffMs": [
      5000,
      30000,
      120000
    ]
  },
  "execution": {
    "windowTimeoutMs": 900000,
    "taskTimeoutMs": 180000,
    "retryMax": 2,
    "retryBackoffSec": 600,
    "circuitBreakerThreshold": 2,
    "circuitBreakerEnabled": true,
    "circuitBreakerCooldownSec": 1800,
    "circuitBreakerMaxCooldownSec": 7200,
    "circuitBreakerProxyCooldownSec": 180,
    "circuitBreakerProxyMaxCooldownSec": 900,
    "circuitBreakerResetAt": "23:59",
    "windowPool": {
      "maxOpenWindows": 4,
      "memoryReserveMb": 100,
      "perWindowMb": 1024,
      "criticalFreeMb": 1024,
      "resumeFreeMb": 2048,
      "checkIntervalMs": 5000,
      "openCooldownMs": 10000,
      "idleCloseSec": 60,
      "windowMaxTasks": 3,
      "windowMaxLifetimeSec": 600,
      "cohortMaxSec": 1800
    },
    "health": {
      "bitbrowserProbeMs": 30000,
      "probeEnabled": true,
      "backoffSec": [
        30,
        60,
        120,
        300,
        600
      ]
    }
  },
  "scheduler": {
    "timezone": "Asia/Shanghai"
  },
  "ai": {
    "provider": "openai-compatible",
    "apiBase": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "apiKey": "",
    "timeoutMs": 30000
  },
  "web": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "wallet": {
    "passwords": {}
  },
  "dataSource": {
    "path": "config/accounts.xlsx"
  },
  "storage": {
    "dbPath": "data/app.db",
    "screenshotDir": "data/screenshots",
    "logDir": "data/logs",
    "logLevel": "info",
    "logRetainDays": 7,
    "dbRetainDays": 90,
    "screenshotRetainDays": 3
  }
}
