{
  "bitbrowser": {
    "apiBase": "http://127.0.0.1:54345",
    "openTimeoutMs": 30000,
    "maxRetries": 3,
    "retryBackoffMs": [
      5000,
      30000,
      120000
    ]
  },
  "execution": {
    "staggerMaxSec": 120,
    "windowTimeoutMs": 900000,
    "taskTimeoutMs": 180000,
    "retryMax": 2,
    "retryBackoffSec": 600,
    "circuitBreakerThreshold": 2,
    "maxConcurrentWindows": 6,
    "humanize": {
      "minDelayMs": 800,
      "maxDelayMs": 3000
    }
  },
  "captcha": {
    "apiBase": "https://api.yescaptcha.com",
    "clientKey": "",
    "solveTimeoutMs": 120000,
    "pollIntervalMs": 3000,
    "maxCostPerTask": 1500,
    "taskTypes": {
      "turnstile": "TurnstileTaskProxyless",
      "recaptcha_v2": "NoCaptchaTaskProxyless",
      "recaptcha_v3": "RecaptchaV3TaskProxyless",
      "hcaptcha": "HCaptchaTaskProxyless",
      "image": "ImageToTextTask"
    }
  },
  "scheduler": {
    "timezone": "Asia/Shanghai"
  },
  "clash": {
    "enabled": true,
    "apiBase": "http://127.0.0.1:7097",
    "apiSecret": "",
    "group": "AutoSelection",
    "testUrls": [
      "https://www.gstatic.com/generate_204",
      "https://www.google.com"
    ],
    "weights": [
      2,
      1
    ],
    "maxNodes": 20,
    "testConcurrency": 2,
    "testTimeoutMs": 5000,
    "minGainMs": 100,
    "autoCheck": {
      "enabled": true,
      "normalIntervalMin": 30,
      "fastIntervalMin": 2
    }
  },
  "web": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "wallet": {
    "passwords": {}
  },
  "dataSource": {
    "path": "config/accounts.xlsx"
  },
  "storage": {
    "dbPath": "data/app.db",
    "screenshotDir": "data/screenshots",
    "logDir": "data/logs",
    "logLevel": "info",
    "logRetainDays": 7,
    "dbRetainDays": 90
  }
}
