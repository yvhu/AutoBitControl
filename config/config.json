{
  "bitbrowser": {
    "apiBase": "http://127.0.0.1:54345",
    "openTimeoutMs": 30000,
    "maxRetries": 3,
    "retryBackoffMs": [
      5000,
      30000,
      120000
    ]
  },
  "execution": {
    "staggerMaxSec": 120,
    "windowTimeoutMs": 900000,
    "taskTimeoutMs": 180000,
    "retryMax": 2,
    "retryBackoffSec": 600,
    "circuitBreakerThreshold": 2,
    "maxConcurrentWindows": 6,
    "humanize": {
      "minDelayMs": 800,
      "maxDelayMs": 3000
    }
  },
  "scheduler": {
    "timezone": "Asia/Shanghai"
  },
  "web": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "wallet": {
    "passwords": {}
  },
  "dataSource": {
    "path": "config/accounts.xlsx"
  },
  "storage": {
    "dbPath": "data/app.db",
    "screenshotDir": "data/screenshots",
    "logDir": "data/logs",
    "logLevel": "info",
    "logRetainDays": 7,
    "dbRetainDays": 90,
    "screenshotRetainDays": 90
  }
}
