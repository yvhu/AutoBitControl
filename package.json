{
  "name": "autobitcontrol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "tsx src/index.ts",
    "build:web": "npm --prefix web run build",
    "test": "vitest run",
    "test:web": "npm --prefix web run test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke:window": "tsx scripts/smoke-open-window.ts",
    "smoke:wallet": "tsx scripts/smoke-wallet.ts",
    "task:run": "tsx scripts/run-task.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@libsql/client": "^0.17.4",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ghost-cursor": "1.4.2",
    "log4js": "^6.9.1",
    "p-queue": "^9.3.3",
    "patchright": "1.62.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.4",
    "marked": "^18.0.11",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
